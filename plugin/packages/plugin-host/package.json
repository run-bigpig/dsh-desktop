    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./mcp": { "types": "./lib/types/mcp.d.ts", "default": "./lib/mcp.js" },
    "./design": { "types": "./lib/types/design.d.ts", "default": "./lib/design.js" },
    "./thinkingdata": { "types": "./lib/types/thinkingdata.d.ts", "default": "./lib/thinkingdata.js" },
    "./vision": { "types": "./lib/types/vision.d.ts", "default": "./lib/vision.js" },
    "./image": { "types": "./lib/types/image.d.ts", "default": "./lib/image.js" },
    "./documents": { "types": "./lib/types/documents.d.ts", "default": "./lib/documents.js" },
    "./workspace": { "types": "./lib/types/workspace.d.ts", "default": "./lib/workspace.js" },
    "./git": { "types": "./lib/types/git.d.ts", "default": "./lib/git.js" },
    "./chart-presentation": { "types": "./lib/types/chart-presentation.d.ts", "default": "./lib/chart-presentation.js" },
